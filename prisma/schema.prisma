generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  expenses      Expense[]
  budgets       Budget[]
  categories    Category[]
  savingsGoals  SavingsGoal[]
  bankAccounts  BankAccount[]
  accountTxns   AccountTransaction[]
}

// ---------- Money ----------

model Expense {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  description String
  amount      Float
  category    String
  date        DateTime
  accountId   String?          @db.ObjectId
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     BankAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  versions    ExpenseVersion[]

  @@index([userId, date])
}

model ExpenseVersion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId   String   @db.ObjectId
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String
  date        DateTime
  accountId   String?  @db.ObjectId
  updatedAt   DateTime @default(now())

  @@index([expenseId])
}

model Budget {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  category String
  amount   Float
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Category {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model SavingsGoal {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Bank accounts ----------

model BankAccount {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  userId       String               @db.ObjectId
  name         String
  balance      Float                @default(0)
  archived     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions AccountTransaction[]
  expenses     Expense[]

  @@unique([userId, name])
}

/// One balance change on an account. `amount` is always positive; `type`
/// says which way it moved: credit | debit | transfer_in | transfer_out | expense.
model AccountTransaction {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String      @db.ObjectId
  accountId  String      @db.ObjectId
  type       String
  amount     Float
  note       String?
  date       DateTime    @default(now())
  expenseId  String?     @db.ObjectId
  transferId String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId, date])
  @@index([expenseId])
}
