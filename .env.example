# MongoDB connection string.
# Prisma requires a replica set (MongoDB Atlas provides one out of the box).
# Local example: mongodb://localhost:27017/dailycheck?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dailycheck"

# Auth.js secret (signs the 7-day login JWT) — generate one with: npx auth secret
AUTH_SECRET=""

# Only needed when deploying behind a proxy / on a non-Vercel host:
# AUTH_URL="https://your-domain.example"
# AUTH_TRUST_HOST=true

# Sign-ups close once the first (owner) account exists. Set to true to let
# more people register.
# ALLOW_SIGNUPS=true
