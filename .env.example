# MongoDB connection string.
# Prisma requires a replica set (MongoDB Atlas provides one out of the box).
# Local example: mongodb://localhost:27017/financeflow?replicaSet=rs0
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/financeflow"

# Auth.js secret — generate one with: npx auth secret
AUTH_SECRET=""

# Google OAuth 2.0 credentials.
# Create at https://console.cloud.google.com/apis/credentials with the
# authorized redirect URI: http://localhost:9002/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed when deploying behind a proxy / on a non-Vercel host:
# AUTH_URL="https://your-domain.example"
# AUTH_TRUST_HOST=true
